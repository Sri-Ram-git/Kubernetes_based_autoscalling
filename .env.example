# Kubernetes Auto-Scaling Framework Environment Configuration
# Project ID: 357 - Alliance University

# Telemetry
PROMETHEUS_URL=http://localhost:9090
METRIC_STALENESS_SECONDS=60

# Scaling Policies & Rules
POLICIES_PATH=policies/scaling-policies.yaml

# Target Kubernetes Workload
TARGET_NAMESPACE=autoscaling-demo
TARGET_DEPLOYMENT=sample-web-app
KUBECONFIG_PATH=

# Safety & Guardrails
DRY_RUN=true
ENABLE_LIVE_EXECUTION=false
MIN_REPLICAS=1
MAX_REPLICAS=10
MAX_SCALE_STEP=2
COOLDOWN_SECONDS=60
HYSTERESIS_BAND_PERCENT=5.0

# Controller Scheduling
EVALUATION_INTERVAL_SECONDS=10
LOG_FILE_PATH=logs/decisions.jsonl

# Web Dashboard
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=5000
SECRET_KEY=dev-secret-key-project-357
